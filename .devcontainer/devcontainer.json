{
  "name": "Proofline 可信分析",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "containerEnv": {
    "VITE_API_BASE_URL": "",
    "VITE_WORKSPACE_SLUG": "moneki"
  },
  "postCreateCommand": "bash .devcontainer/bootstrap.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "Proofline 产品体验",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "Proofline API",
      "onAutoForward": "silent"
    }
  }
}
